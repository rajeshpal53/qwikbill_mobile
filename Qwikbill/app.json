{
  "expo": {
    "name": "QwikBill",
    "slug": "qwikbill",
    "version": "1.0.3",
    "newArchEnabled": true,
    "icon": "./assets/qLogo.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/qLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "transparent",
      "barStyle": "light-content"
    },
    "plugins": [
      "@config-plugins/react-native-pdf",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow $(PRODUCT_NAME) to use Face ID."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow ${PRODUCT_NAME} to use the microphone.",
          "speechRecognitionPermission": "Allow ${PRODUCT_NAME} to use speech recognition.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "resizeableActivity": true
          },"ios": {
            "useFrameworks": "static",
            "useModularHeaders": true
          }
        }
      ],
      "expo-web-browser",
      "expo-audio"
    ],
     "ios": {
      "useFrameworks": "static",
       "buildConfiguration": {
        "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES": "YES"
      },
  "hermesEnabled": true,
  "supportsTablet": true,
  "bundleIdentifier": "com.wertone.qwikbill",
  "googleServicesFile": "./GoogleService-Info.plist",
  "infoPlist": {
  "NSAppTransportSecurity": {
    "NSAllowsArbitraryLoads": true
  },
  "NSUserNotificationUsageDescription": "Qwikbill uses notifications to inform users about important billing updates, payment alerts, and account-related activities.",
        "NSCameraUsageDescription": "Qwikbill uses the camera to capture images or documents for uploading bills and verification purposes.",
        "NSMicrophoneUsageDescription": "Qwikbill uses the microphone only when users intentionally record audio or video within the app.",
        "NSPhotoLibraryUsageDescription": "Qwikbill accesses the photo library to allow users to select images or documents for bill uploads.",
        "NSDocumentsFolderUsageDescription": "Qwikbill accesses files only to allow users to upload Excel documents for billing data processing.",
  "UIBackgroundModes": ["remote-notification"],
  "ITSAppUsesNonExemptEncryption": false,
  "FirebaseAppDelegateProxyEnabled": true
}
},
    "android": {
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/qLogo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "USE_FINGERPRINT",
        "USE_BIOMETRIC",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.wertone.qwikbill"
    },
    "web": {
      "favicon": "./assets/qLogo.png"
    },
    "extra": {
      "eas": {
        "projectId": "230e4be6-1127-4c5c-a287-888b54ae4faf"
      }
    },
    "owner": "wertone"
  }
}
